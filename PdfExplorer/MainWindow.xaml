<Window x:Class="PdfExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfExplorer" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl>
            <TabItem Header="Search">
                <Frame Source="Views/SearchTab.xaml" NavigationUIVisibility="Hidden" />
            </TabItem>
            <TabItem Header="Index Creation">
                <Frame Source="Views/IndexTab.xaml" NavigationUIVisibility="Hidden" />
            </TabItem>
            <TabItem Header="Settings">
                <Frame Source="Views/SettingsTab.xaml" NavigationUIVisibility="Hidden" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
