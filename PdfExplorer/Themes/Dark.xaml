<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PageForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlForeground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#3E3E3E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#555555" />
    <SolidColorBrush x:Key="ErrorBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#FF6B6B" />
    <SolidColorBrush x:Key="ProgressBrush" Color="#0078D4" />

</ResourceDictionary>
