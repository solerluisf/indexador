<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page/Window -->
    <SolidColorBrush x:Key="PageBackground" Color="#F0F4F8" />
    <SolidColorBrush x:Key="PageForeground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="WindowBackground" Color="#F0F4F8" />
    <SolidColorBrush x:Key="WindowForeground" Color="#1A1A2E" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlForeground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="ControlBorder" Color="#B0B8C8" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2B5797" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#B0B8C8" />

    <!-- Error -->
    <SolidColorBrush x:Key="ErrorBackground" Color="#FFF0F0" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#CC0000" />

    <!-- Progress -->
    <SolidColorBrush x:Key="ProgressBrush" Color="#2B5797" />

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#DCE3ED" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#C8D2E0" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#A0B0C8" />

    <!-- Selection -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#2B5797" />
    <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="#E4E9F0" />
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#B0B8C8" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#9098A8" />

    <!-- ListBox -->
    <SolidColorBrush x:Key="ListBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListBoxForeground" Color="#1A1A2E" />

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#FFFFFF" />

    <!-- TextBox -->
    <SolidColorBrush x:Key="TextBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBoxForeground" Color="#1A1A2E" />

    <!-- StatusBar -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#2B5797" />
    <SolidColorBrush x:Key="StatusBarForeground" Color="#FFFFFF" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="DisabledBackground" Color="#E4E9F0" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#9098A8" />

    <!-- Header/Separator -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#E4E9F0" />
    <SolidColorBrush x:Key="SeparatorBackground" Color="#B0B8C8" />

    <!-- ToolTip -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFE1" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#1A1A2E" />

    <!-- Tab -->
    <SolidColorBrush x:Key="TabBackground" Color="#E4E9F0" />
    <SolidColorBrush x:Key="TabSelectedBackground" Color="#F0F4F8" />
    <SolidColorBrush x:Key="TabForeground" Color="#1A1A2E" />

    <!-- Hyperlink -->
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#1A73E8" />

    <!-- Search highlight in PDF -->
    <SolidColorBrush x:Key="SearchHighlightBackground" Color="#FFD700" />
    <SolidColorBrush x:Key="SearchHighlightBorder" Color="#FFA500" />

</ResourceDictionary>