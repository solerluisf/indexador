<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBackground" Color="#F0F4F8" />
    <SolidColorBrush x:Key="PageForeground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlForeground" Color="#1A1A2E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B5797" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#DEE5ED" />
    <SolidColorBrush x:Key="BorderBrush" Color="#B0C4DE" />
    <SolidColorBrush x:Key="ErrorBackground" Color="#FFF5F5" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#CC0000" />
    <SolidColorBrush x:Key="ProgressBrush" Color="#2B5797" />

</ResourceDictionary>
