<Page x:Class="PdfExplorer.Views.IndexTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Index Creation"
      Background="{DynamicResource PageBackground}" Foreground="{DynamicResource PageForeground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Collection picker -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="CollectionList" Width="300" Height="28"
                      DisplayMemberPath="Label" />
            <Button x:Name="AddCollectionBtn" Content="Add Folder" Width="100" Height="28" Margin="10,0,0,0"
                    Click="OnAddCollection" />
            <Button x:Name="RemoveCollectionBtn" Content="Remove" Width="80" Height="28" Margin="10,0,0,0"
                    Click="OnRemoveCollection" />
        </StackPanel>

        <!-- Progress area -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
            <Label x:Name="StatusLabel" Content="Ready" HorizontalAlignment="Center" FontSize="16" />
            <ProgressBar x:Name="ProgressBar" Width="400" Height="24" Margin="0,10,0,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed" />

            <!-- Problematic files section -->
            <Expander x:Name="ProblematicExpander" Header="Show problematic files" IsExpanded="False"
                      Visibility="Collapsed" Margin="0,10,0,0">
                <ListView x:Name="ProblematicList" Height="200" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File" Width="300" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Issue" Width="250" DisplayMemberBinding="{Binding Issue}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Expander>

            <!-- Error log -->
            <TextBox x:Name="ErrorLogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="150" Margin="0,10,0,0"
                     Visibility="Collapsed" FontFamily="Consolas" FontSize="11"
                     Background="{DynamicResource ErrorBackground}" Foreground="{DynamicResource ErrorForeground}" BorderThickness="1" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <CheckBox x:Name="OcrCheckbox" Content="OCR image PDFs" VerticalAlignment="Center"
                       IsChecked="False" Margin="0,0,10,0" Checked="OnOcrToggled" Unchecked="OnOcrToggled" />
            <TextBlock x:Name="OcrStatus" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource ControlForeground}" FontSize="11" Opacity="0.7"/>
            <Button x:Name="IndexBtn" Content="Index" Width="100" Height="32"
                    Click="OnIndex" />
            <Button x:Name="CancelBtn" Content="Cancel" Width="100" Height="32" Margin="10,0,0,0"
                    Click="OnCancel" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Page>
