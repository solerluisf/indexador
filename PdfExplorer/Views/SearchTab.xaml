<Page x:Class="PdfExplorer.Views.SearchTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PdfExplorer.Views"
      Title="Search"
      Background="{DynamicResource PageBackground}" Foreground="{DynamicResource PageForeground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main split: results list (left) + PDF viewer (right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results list -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Results" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox Grid.Row="1" x:Name="ResultsList"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnResultSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Thumbnail -->
                                    <Image Grid.Column="0" Source="{Binding Thumbnail}"
                                           Width="100" Height="100" Stretch="Uniform"
                                           Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- Text info -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextWrapping="NoWrap"/>
                                         <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{DynamicResource ControlForeground}" TextWrapping="NoWrap" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Snippet}" FontSize="10" Foreground="{DynamicResource ControlForeground}"
                                                   TextWrapping="Wrap" MaxHeight="40" Opacity="0.6"/>
                                        <TextBlock Text="{Binding Score, Mode=OneWay, StringFormat='Score: {0:F2}'}" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Filtered native PDF viewer -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Match navigation bar -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Filtered Viewer" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="PrevMatch" Content="◀" Width="28" Height="24"
                                Click="OnPrevMatch" IsEnabled="False" ToolTip="Previous match"/>
                        <Label x:Name="MatchInfo" Content="0 matches" VerticalAlignment="Center" Margin="4,0"/>
                        <Button x:Name="NextMatch" Content="▶" Width="28" Height="24"
                                Click="OnNextMatch" IsEnabled="False" ToolTip="Next match"/>
                        <Separator Width="1" Height="20" Margin="8,0" Background="{DynamicResource SeparatorBackground}"/>
                        <TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource ControlForeground}" Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Canvas-based virtualized PDF viewer -->
                <Grid Grid.Row="1" Focusable="True"
                      Background="{DynamicResource WindowBackground}"
                      PreviewKeyDown="OnViewerKeyDown">
                    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  ScrollChanged="OnPageScrollerScroll">
                        <Canvas x:Name="PageCanvas" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>

                <!-- Extracted words field -->
                <TextBox Grid.Row="2" x:Name="WordsField"
                         IsReadOnly="True"
                         Height="0"
                         Visibility="Collapsed"
                         Margin="0,5,10,0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="11"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ControlForeground}"
                         Background="{DynamicResource ControlBackground}"
                         Text=""/>
            </Grid>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Collection:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="CollectionFilter" Width="180" Height="28"
                      DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectionChanged="OnCollectionFilterChanged" />

            <Label Grid.Column="2" Content="Search:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Grid.Column="3" x:Name="SearchBox" Height="28" IsEnabled="False"
                     KeyDown="OnSearchBoxKeyDown"/>
            <ComboBox Grid.Column="4" x:Name="SearchModeCombo" Height="28" SelectedIndex="0"
                      SelectionChanged="OnSearchModeChanged">
                <ComboBoxItem Content="Auto phrase"/>
                <ComboBoxItem Content="Boolean phrase"/>
            </ComboBox>
            <Button Grid.Column="5" x:Name="SearchButton" Content="Search" Height="28" Margin="5,0,0,0"
                    Click="OnSearchClick" IsEnabled="False"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="10,0,0,0">
                <Button x:Name="PrevPage" Content="◀◀" Width="30" Height="28"
                        Click="OnPrevPage" IsEnabled="False" ToolTip="Previous page of results"/>
                <Label x:Name="PageInfo" Content="0 / 0" VerticalAlignment="Center" Margin="5,0"/>
                <Button x:Name="NextPage" Content="▶▶" Width="30" Height="28"
                        Click="OnNextPage" IsEnabled="False" ToolTip="Next page of results"/>
                <Separator Width="1" Height="20" Margin="8,0" Background="{DynamicResource SeparatorBackground}"/>
                <Button x:Name="PrevPosition" Content="◀" Width="28" Height="24"
                        Click="OnPrevPosition" IsEnabled="False" ToolTip="Previous match"/>
                <Label x:Name="PositionInfo" Content="0 / 0" VerticalAlignment="Center" Margin="4,0"/>
                <Button x:Name="NextPosition" Content="▶" Width="28" Height="24"
                        Click="OnNextPosition" IsEnabled="False" ToolTip="Next match"/>
            </StackPanel>

            <Separator Grid.Column="7" Width="1" Height="20" Margin="4,0" Background="{DynamicResource SeparatorBackground}"/>
            <Label Grid.Column="8" Content="Zoom:" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <ComboBox Grid.Column="9" x:Name="ZoomCombo" Width="75" Height="28"
                      SelectedIndex="3" SelectionChanged="OnZoomChanged">
                <ComboBoxItem Content="50%"/>
                <ComboBoxItem Content="75%"/>
                <ComboBoxItem Content="100%"/>
                <ComboBoxItem Content="Fit Width"/>
                <ComboBoxItem Content="Fit Page"/>
                <ComboBoxItem Content="150%"/>
                <ComboBoxItem Content="200%"/>
            </ComboBox>

            <StatusBar Grid.Column="10" Margin="10,0,0,0">
                <StatusBarItem x:Name="StatusItem">
                    <TextBlock x:Name="ResultCountLabel" Text="Ready"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Page>
