<Page x:Class="PdfExplorer.Views.SearchTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Search">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main split: results list (left) + PDF viewer (right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results list -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Results" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox Grid.Row="1" x:Name="ResultsList"
                         SelectionChanged="OnResultSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="Gray" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Snippet}" FontSize="10" Foreground="DimGray"
                                               TextWrapping="Wrap" MaxHeight="40"/>
                                    <TextBlock FontSize="9" Foreground="DarkBlue">
                                        <Run Text="Score: "/><Run Text="{Binding Score, StringFormat={}{0:F2}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Filtered native PDF viewer -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Match navigation bar -->
                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Filtered Viewer" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="PrevMatch" Content="◀" Width="28" Height="24"
                                Click="OnPrevMatch" IsEnabled="False" ToolTip="Previous match"/>
                        <Label x:Name="MatchInfo" Content="0 matches" VerticalAlignment="Center" Margin="4,0"/>
                        <Button x:Name="NextMatch" Content="▶" Width="28" Height="24"
                                Click="OnNextMatch" IsEnabled="False" ToolTip="Next match"/>
                        <Separator Width="1" Height="20" Margin="8,0" Background="LightGray"/>
                        <TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable page list -->
                <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PageStack" Margin="0,0,10,0"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Search:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="SearchBox" Height="28"/>
            <Button Grid.Column="2" x:Name="SearchButton" Content="Search" Height="28" Margin="5,0,0,0"
                    Click="OnSearchClick"/>

            <ComboBox Grid.Column="3" x:Name="SearchMode" Width="120" Height="28" Margin="10,0,0,0"
                      SelectedIndex="0" SelectionChanged="OnSearchModeChanged">
                <ComboBoxItem Content="Standard"/>
                <ComboBoxItem Content="Fuzzy"/>
                <ComboBoxItem Content="Stem"/>
                <ComboBoxItem Content="Boolean"/>
            </ComboBox>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="20,0,0,0">
                <Button x:Name="PrevPage" Content="◀◀" Width="30" Height="28"
                        Click="OnPrevPage" IsEnabled="False" ToolTip="Previous page of results"/>
                <Label x:Name="PageInfo" Content="0 / 0" VerticalAlignment="Center" Margin="5,0"/>
                <Button x:Name="NextPage" Content="▶▶" Width="30" Height="28"
                        Click="OnNextPage" IsEnabled="False" ToolTip="Next page of results"/>
            </StackPanel>

            <StatusBar Grid.Column="5" Margin="10,0,0,0">
                <StatusBarItem x:Name="StatusItem">
                    <TextBlock x:Name="ResultCountLabel" Text="Ready"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Page>
