<UserControl x:Class="PdfExplorer.Views.PdfPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Border BorderBrush="Silver" BorderThickness="1"
                Padding="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding PageHeader}"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Image Source="{Binding PageImage}"
                       Stretch="Uniform" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
        <ProgressBar IsIndeterminate="True" Width="100" Height="10"
                     VerticalAlignment="Center" HorizontalAlignment="Center"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
