<Page x:Class="PdfExplorer.Views.SettingsTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="{DynamicResource PageBackground}" Foreground="{DynamicResource PageForeground}">
    <ScrollViewer Margin="10">
        <StackPanel>

            <!-- Appearance -->
            <Expander Header="Appearance" IsExpanded="True">
                <StackPanel Margin="20,10">
                    <Label Content="Theme" />
                    <ComboBox x:Name="ThemeSelector" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light Blue" />
                    </ComboBox>
                    <Label Content="Render DPI" />
                    <ComboBox x:Name="DpiSelector" Width="100" HorizontalAlignment="Left"
                              SelectionChanged="OnDpiChanged">
                        <ComboBoxItem Content="72" />
                        <ComboBoxItem Content="96" />
                        <ComboBoxItem Content="150" />
                        <ComboBoxItem Content="200" />
                        <ComboBoxItem Content="300" />
                        <ComboBoxItem Content="400" />
                        <ComboBoxItem Content="600" />
                    </ComboBox>
                    <CheckBox x:Name="InvertPdfCheckbox" Content="Invert PDF colors for dark mode"
                              Margin="0,10,0,0" Checked="OnInvertPdfToggled" Unchecked="OnInvertPdfToggled"/>
                </StackPanel>
            </Expander>

            <!-- OCR -->
            <Expander Header="OCR" IsExpanded="False">
                <StackPanel Margin="20,10">
                    <Label Content="Tesseract Path" />
                    <TextBox x:Name="TesseractPath" Width="400" HorizontalAlignment="Left" />
                    <Label Content="Language" />
                    <TextBox x:Name="OcrLanguage" Text="eng" Width="200" HorizontalAlignment="Left" />
                    <Label Content="Workers" />
                    <Slider x:Name="OcrWorkers" Minimum="1" Maximum="16" TickFrequency="1"
                            Value="4" Width="300" HorizontalAlignment="Left" />
                    <Label Content="Max Image Dimension" />
                    <Slider x:Name="OcrMaxDim" Minimum="500" Maximum="10000" TickFrequency="500"
                            Value="3000" Width="300" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <!-- Indexing performance -->
            <Expander Header="Indexing Performance" IsExpanded="False">
                <StackPanel Margin="20,10">
                    <Label Content="RAM Buffer" />
                    <ComboBox x:Name="RamBuffer" SelectedIndex="2">
                        <ComboBoxItem Content="256 MB" />
                        <ComboBoxItem Content="512 MB" />
                        <ComboBoxItem Content="1 GB" />
                        <ComboBoxItem Content="2 GB" />
                        <ComboBoxItem Content="3 GB" />
                        <ComboBoxItem Content="4 GB" />
                    </ComboBox>
                    <Label Content="Batch Size" />
                    <Slider x:Name="BatchSize" Minimum="50" Maximum="5000" TickFrequency="50"
                            Value="500" Width="300" HorizontalAlignment="Left" />
                    <Label Content="Commit Interval (docs)" />
                    <Slider x:Name="CommitInterval" Minimum="100" Maximum="50000" TickFrequency="100"
                            Value="5000" Width="300" HorizontalAlignment="Left" />
                    <Label Content="Commit Timeout (s)" />
                    <Slider x:Name="CommitTimeout" Minimum="5" Maximum="300" TickFrequency="5"
                            Value="30" Width="300" HorizontalAlignment="Left" />
                    <Label Content="Extract Workers" />
                    <Slider x:Name="ExtractWorkers" Minimum="1" Maximum="32" TickFrequency="1"
                            Value="6" Width="300" HorizontalAlignment="Left" />
                    <Label Content="Channel Capacity" />
                    <Slider x:Name="ChannelCapacity" Minimum="16" Maximum="8192" TickFrequency="16"
                            Value="500" Width="300" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <!-- Collection boosts -->
            <Expander Header="Collection Boosts" IsExpanded="False">
                <StackPanel Margin="20,10" x:Name="BoostsPanel">
                    <!-- Populated dynamically -->
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
